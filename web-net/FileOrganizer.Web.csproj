<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FileOrganizer.Web</RootNamespace>
    <AssemblyName>FileOrganizer.Web</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.8" />
    <PackageReference Include="Dapper" Version="2.1.35" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="FileOrganizer.Tests\**" />
    <Content Remove="FileOrganizer.Tests\**" />
    <EmbeddedResource Remove="FileOrganizer.Tests\**" />
    <None Remove="FileOrganizer.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <FrontendFiles Include="..\src\api\static\**\*.*" />
  </ItemGroup>

  <Target Name="CopyFrontendFiles" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="@(FrontendFiles)" DestinationFolder="wwwroot\%(RecursiveDir)" SkipUnchangedFiles="true" />
  </Target>
</Project>
